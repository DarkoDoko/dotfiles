[user]
	name = Darko Doko
	email = darko.doko1@gmail.com

[include]
	path = ~/.gitconfig-personal

[init]
	defaultBranch = main

[pull]
	rebase = false

[core]
	editor = nano

[gpg]
	format = ssh

[commit]
	gpgsign = true

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

# Keep last: later settings win, so the work overlay must come after everything it overrides.
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work
