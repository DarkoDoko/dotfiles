[user]
	name = Darko Doko
	email = darko.doko1@gmail.com
	signingkey = ~/.ssh/id_ed25519_github.pub

[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work

[init]
	defaultBranch = main

[pull]
	rebase = false

[core]
	editor = nano

[gpg]
	format = ssh

[commit]
	gpgsign = true

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
